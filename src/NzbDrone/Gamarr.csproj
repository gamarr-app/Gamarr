<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allow Linux runners (Dependabot scanner) to restore this Windows-only project. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>..\NzbDrone.Host\Gamarr.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <!-- Needed by GenerateResourceUsePreserializedResources. SDK 11 (which global.json's
         latestMajor roll-forward picks up on GitHub's dependency-submission runner) ships it
         in-box for net10.0-windows and fails restore with NU1510 (per-reference NoWarn is not
         honoured for it), so only reference it on older SDKs, which still need it. -->
    <PackageReference Include="System.Resources.Extensions" Version="10.0.14" Condition="$([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '11.0'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Host\Gamarr.Host.csproj" />
    <ProjectReference Include="..\NzbDrone.Windows\Gamarr.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
